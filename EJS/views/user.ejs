<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>
</head>
<body>
    <h1>Edit User</h1>
    <form action="/api/user/<%= userData[0].id %>?_method=PUT" method="POST">
    <input type="text" name="name" value="<%= userData[0].name %>" required>
    <br>
    <input type="number" name="age" value="<%= userData[0].age %>" required>
    <br>
    <button type="submit">Update User</button>
    <br>
    <a href="/user">back</a>
    </form>
</body>
</html>