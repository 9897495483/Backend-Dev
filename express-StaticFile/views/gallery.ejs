<!DOCTYPE html>
<html>
<head>
  <title>Photo Gallery</title>
  <style>
    body {
      font-family: Arial;
      background: #f4f4f4;
    }
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
      padding: 20px;
    }
    img {
        width: 100%;
        height: auto;
        border-radius: 8px;
    }
  </style>
</head>
<body>

  <h1 style="text-align:center;">My Photo Gallery</h1>

  <div class="gallery">
    <% images.forEach((img) => { %>
      <img src="/images/<%= img %>" alt="photo">
    <% }) %>
  </div>

</body>
</html>